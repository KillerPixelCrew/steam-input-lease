<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The release outcome carries its UTF-8 reason as an inline fixed buffer,
         which keeps the struct blittable for NativeAOT consumers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>SteamInputLease</AssemblyName>
    <RootNamespace>SteamInputLease</RootNamespace>
    <PackageId>SteamInputLease</PackageId>
    <Version>0.1.0</Version>
    <Description>Managed bindings for dynamically leasing Steam Input controller access.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="Exists('..\..\target\release\steam_input_lease_ffi.dll')">
    <None Include="..\..\target\release\steam_input_lease_ffi.dll"
          Link="steam_input_lease_ffi.dll"
          CopyToOutputDirectory="PreserveNewest"
          Pack="true"
          PackagePath="runtimes\win-x64\native" />
    <None Include="..\..\target\release\steam_input_gate.dll"
          Link="steam_input_gate.dll"
          CopyToOutputDirectory="PreserveNewest"
          Pack="true"
          PackagePath="runtimes\win-x64\native" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD_PARTY_LICENSES.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
